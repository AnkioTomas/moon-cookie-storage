{
  "manifest_version": 3,
  "name": "Moon Cookie Storage",
  "version": "0.1.2",
  "description": "Cookie storage extension for Chrome, Edge and Firefox",
  "permissions": ["cookies", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Moon Cookie Storage",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["wait.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
